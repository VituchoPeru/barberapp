    { "name": "Mis citas", "short_name": "Mis citas", "url": "./pages/mis-citas.html", "icons": [{ "src": "assets/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Mi cuenta y paneles", "short_name": "Mi cuenta", "url": "./pages/auth/cuenta.html", "icons": [{ "src": "assets/icons/icon-192.png", "sizes": "192x192" }] }
  ]
