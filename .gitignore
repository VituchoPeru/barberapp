# Secretos y entorno
backend/.env
*.env.local

# Dependencias
backend/vendor/
frontend/node_modules/

# Logs y temporales
backend/storage/logs/*.log
.phpunit.result.cache
backend/.phpunit.result.cache
.DS_Store
Thumbs.db
.idea/
.vscode/
backend/storage/mail/*.eml

# Imágenes subidas por las barberías (Fase 3)
backend/public/media/tenants/

# Avisos push en desarrollo y caché del token OAuth de FCM (Fase 8)
backend/storage/push/*.log
backend/storage/cache/*.json
backend/storage/cache/*.lock
backend/storage/cache/latidos/
# Cuentas de servicio de Firebase: nunca al repositorio
*firebase-adminsdk*.json

# Copias de seguridad de la base (Fase 13): contienen datos personales, nunca al repositorio
backend/storage/backups/*
!backend/storage/backups/.gitkeep
!backend/storage/backups/.htaccess
*.sql.gz
*.sql.gz.enc

# Pruebas E2E (Fase 14): sesiones, resultados e informes generados
frontend/e2e/.auth/
frontend/e2e-resultados/
frontend/e2e-informe/
