# ============================================================
# BARBERAPP — variables de entorno del backend
# Copie este archivo como .env y ajuste los valores.
# NUNCA suba .env al repositorio ni lo coloque dentro de public/.
# ============================================================

APP_NAME=BARBERAPP
# local | testing | staging | production
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost/barberapp/backend/public
FRONTEND_URL=http://localhost/barberapp/frontend/www
# Base del enlace directo de cada barbería ({valor}/b/{slug}) y de su código QR.
# En producción: https://app.barberapp.pe  (vacío = FRONTEND_URL)
PUBLIC_BOOKING_URL=
FORCE_HTTPS=false
LOG_LEVEL=debug
DEFAULT_TENANT_TIMEZONE=America/Lima
MAX_BODY_BYTES=1048576

# Clave secreta para firmar tokens. Genérela con: php bin/console key:generate
APP_KEY=

# Sesiones web (cookie HttpOnly). En producción con HTTPS: SESSION_SECURE_COOKIE=true
SESSION_COOKIE_NAME=barberapp_session
SESSION_SECURE_COOKIE=false
SESSION_SAMESITE=Lax
SESSION_LIFETIME_HOURS=168
SESSION_IDLE_MINUTES=120

# App móvil: access token corto + refresh token rotativo
AUTH_ACCESS_TTL=900
AUTH_REFRESH_TTL_DAYS=30
AUTH_MOBILE_SESSION_DAYS=90

# Correo saliente: log (archivos .eml en storage/mail) | smtp
MAIL_DRIVER=log
MAIL_FROM_ADDRESS=no-reply@barberapp.pe
MAIL_FROM_NAME=BARBERAPP
MAIL_HOST=
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=
MAIL_PASSWORD=

# Base de datos MySQL 8 (en XAMPP el usuario root no tiene contraseña por defecto)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=barberapp
DB_USERNAME=root
DB_PASSWORD=
DB_SOCKET=
DB_TIMEOUT=5

# Base de datos para pruebas automáticas (se BORRA y recrea en cada ejecución)
DB_TEST_DATABASE=barberapp_test

# Orígenes permitidos para CORS, separados por coma (incluya los de Capacitor)
CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:8080,capacitor://localhost,https://localhost

# Contraseña de los usuarios de demostración creados por "php bin/console db:seed --demo"
# (solo entornos local/testing; el seeder de demostración se niega a correr en production)
DEMO_PASSWORD=Demo2026!

# Fotos de las barberías (Fase 3). MEDIA_PATH vacío = backend/public/media; MEDIA_URL vacío = APP_URL/media
MEDIA_PATH=
MEDIA_URL=
MEDIA_MAX_UPLOAD_BYTES=5242880
