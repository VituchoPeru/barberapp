{
    "name": "barberapp/backend",
    "description": "BARBERAPP SaaS — API REST en PHP puro (sin frameworks)",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.0",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*",
        "ext-json": "*",
        "ext-mbstring": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Seeds\\": "database/seeds/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "platform": {
            "php": "8.0.30"
        },
        "sort-packages": true
    },
    "scripts": {
        "test": "phpunit",
        "lint": "find app bootstrap config routes public database bin tests -name '*.php' -print0 | xargs -0 -n1 php -l"
    },
    "minimum-stability": "stable"
}
