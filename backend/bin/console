#!/usr/bin/env php
<?php

declare(strict_types=1);

/**
 * Consola de BARBERAPP.
 *
 *   php bin/console db:create          Crea la base de datos (DB_DATABASE) si no existe
 *   php bin/console migrate            Aplica migraciones pendientes
 *   php bin/console migrate:status     Lista migraciones y su estado
 *   php bin/console migrate:fresh      BORRA todas las tablas y migra de nuevo (solo local/testing)
 *   php bin/console db:seed            Datos de catálogo (roles, permisos, planes, plantillas)
 *   php bin/console db:seed --demo     Catálogo + datos de demostración (solo local/testing)
 *   php bin/console schema:build       Regenera database/schema.sql desde las migraciones
 *   php bin/console routes             Lista las rutas registradas
 *   php bin/console docs:generar       Regenera la documentación generada (Fase 16): OpenAPI, diccionario de datos,
 *                                      diagramas ER, endpoints y errores de docs/API.md, matriz de pruebas
 *   php bin/console docs:verificar     Comprueba que esa documentación está al día; código 1 si no (CI)
 *   php bin/console docs:dictionary    Alias de docs:generar (nombre anterior)
 *   php bin/console key:generate       Genera APP_KEY en .env (firma de tokens; --force para reemplazarla)
 *   php bin/console auth:purge         Borra sesiones, tokens y contadores vencidos (programar en cron diario)
 *   php bin/console reservas:purge     Borra claves de idempotencia vencidas (24 h; programar en cron diario)
 *   php bin/console notificaciones:procesar [--limite=200]
 *                                      Worker de avisos: programa recordatorios y envía la cola (cron cada minuto)
 *   php bin/console notificaciones:estado
 *                                      Resumen de la cola y de los envíos de las últimas 24 h
 *   php bin/console notificaciones:purge
 *                                      Borra avisos resueltos más antiguos que NOTIFY_RETENTION_DAYS (cron diario)
 *   php bin/console suscripciones:vencer
 *                                      Cron cada hora: cambios de plan programados, vencimientos, restricción
 *                                      tras la gracia, avisos de vencimiento y órdenes de pago expiradas
 *   php bin/console push:probar correo@dominio
 *                                      Envía un push de prueba a los dispositivos de esa cuenta (verifica FCM)
 *
 *   Seguridad y protección de datos (Fase 13)
 *   php bin/console seguridad:revisar  Revisa la configuración (HTTPS, claves, CORS, copias…); código 1 si hay errores
 *   php bin/console privacidad:retencion
 *                                      Aplica la política de retención de datos (cron diario)
 *   php bin/console backup:clave       Genera BACKUP_KEY en .env (cifrado de las copias; --force para reemplazarla)
 *   php bin/console backup:crear       Copia cifrada de la base (cron diario); conserva BACKUP_KEEP copias
 *   php bin/console backup:listar      Lista las copias guardadas
 *   php bin/console backup:verificar [archivo]
 *                                      Prueba de restauración en una base temporal (cron semanal)
 *   php bin/console backup:restaurar <archivo> --base=<nombre> [--sobrescribir] [--limpiar]
 *                                      Restaura en otra base; sobre DB_DATABASE solo con --sobrescribir;
 *                                      --limpiar borra antes todas las tablas (también las que no están en la copia)
 *   php bin/console backup:restaurar <archivo> --solo-descifrar=<destino.sql.gz>
 *                                      Descifra la copia para restaurarla a mano (gunzip | mysql)
 *
 *   Despliegue y producción (Fase 15, ver docs/DESPLIEGUE.md)
 *   php bin/console backup:enviar      Sube las copias cifradas y las fotos al almacenamiento externo (cron diario)
 *   php bin/console backup:remotas     Lista las copias guardadas fuera del servidor
 *   php bin/console backup:traer [archivo]
 *                                      Baja una copia externa (la última si no se indica) y verifica su SHA-256
 *   php bin/console notificaciones:procesar --continuo [--pausa=5] [--max-minutos=60]
 *                                      Worker permanente (servicio systemd): procesa la cola sin esperar al cron
 *   php bin/console monitor:revisar [--alertar] [--json] [--silencioso] [--sin-certificados]
 *                                      Estado de producción (base, cron, worker, copias, disco, errores, HTTPS);
 *                                      código 1 si hay problemas; --alertar envía correo a MONITOR_EMAIL
 *   php bin/console mantenimiento:activar [--motivo=texto] [--reintentar=60]
 *   php bin/console mantenimiento:desactivar
 *                                      La API responde 503 mientras se actualiza
 *   php bin/console logs:purge         Borra registros de más de LOG_RETENTION_DAYS días (cron diario)
 *   php bin/console plataforma:superadmin correo@dominio [--nombre=…]
 *                                      Crea (o promueve) la primera cuenta de superadministrador en producción
 *   php bin/console despliegue:verificar
 *                                      Revisión previa a publicar una versión (PHP, extensiones, permisos, base,
 *                                      CORS, DNS y seguridad); código 1 si hay errores
 *   php bin/console despliegue:config --salida=<carpeta> [--servidor=nginx|apache] [--raiz=/var/www/barberapp]
 *                                      [--usuario=barberapp] [--php=8.3] [--worker=systemd|cron] [--ips-plataforma=…]
 *                                      Genera Nginx/Apache, PHP-FPM, cron, systemd y logrotate desde .env
 *   php bin/console despliegue:frontend --version=<id> [--www=<carpeta>]
 *                                      Fija la URL de la API en el frontend y la versión del service worker
 */

use App\Core\Config;
use App\Core\Database;
use App\Core\Env;
use App\Core\Migrator;
use Database\Seeds\CatalogSeeder;
use Database\Seeds\DemoSeeder;

$base = dirname(__DIR__);
require $base . '/bootstrap/autoload.php';
Env::load($base . '/.env');
Config::loadDirectory($base . '/config');
date_default_timezone_set('UTC');

$command = $argv[1] ?? 'help';
$flags = array_slice($argv, 2);

function out(string $msg): void
{
    fwrite(STDOUT, $msg . PHP_EOL);
}

function fail(string $msg): void
{
    fwrite(STDERR, "ERROR: {$msg}" . PHP_EOL);
    exit(1);
}

function assertNonProduction(string $what): void
{
    $env = (string) Config::get('app.env');
    if (!in_array($env, ['local', 'testing'], true)) {
        fail("{$what} solo se permite con APP_ENV=local o testing (actual: {$env}).");
    }
}

/** BARBERAPP requiere MySQL 8.0+. XAMPP trae MariaDB, que no es compatible con este esquema. */
function assertMysql8(PDO $pdo): void
{
    $version = (string) $pdo->query('SELECT VERSION()')->fetchColumn();
    if (stripos($version, 'mariadb') !== false) {
        fail("El servidor es MariaDB ({$version}). BARBERAPP requiere MySQL 8.0+ (vea README: sección XAMPP).");
    }
    if (version_compare(preg_replace('/[^0-9.].*$/', '', $version) ?? '0', '8.0.16', '<')) {
        fail("MySQL {$version} no soportado. Se requiere MySQL 8.0.16 o superior (restricciones CHECK).");
    }
}

/** @return array<string, string> opciones --clave=valor (y --bandera → '1') */
function options(array $flags): array
{
    $o = [];
    foreach ($flags as $f) {
        if (preg_match('/^--([a-z][a-z0-9-]*)(?:=(.*))?$/', $f, $m)) {
            $o[$m[1]] = $m[2] ?? '1';
        }
    }
    return $o;
}

/** @param list<array{nivel: string, tema: string, mensaje: string}> $items */
function printChecks(array $items, bool $onlyProblems = false): int
{
    $errors = 0;
    foreach ($items as $item) {
        $errors += $item['nivel'] === 'error' ? 1 : 0;
        if ($onlyProblems && $item['nivel'] === 'ok') {
            continue;
        }
        $marca = ['ok' => '  ✔', 'aviso' => '  !', 'error' => '  ✖'][$item['nivel']] ?? '  ·';
        out("{$marca} {$item['tema']}: {$item['mensaje']}");
    }
    return $errors;
}

// Tareas programadas que dejan un latido al terminar bien (monitor:revisar los vigila).
$heartbeatTasks = ['notificaciones:procesar', 'suscripciones:vencer', 'backup:crear', 'backup:verificar', 'backup:enviar',
    'privacidad:retencion', 'auth:purge', 'reservas:purge', 'notificaciones:purge', 'logs:purge'];
$heartbeat = in_array($command, $heartbeatTasks, true);
$heartbeatData = [];

try {
    if (in_array($command, ['db:create', 'migrate', 'migrate:fresh'], true)) {
        assertMysql8(Database::connect(Config::get('database'), false));
    }
    switch ($command) {
        case 'db:create':
            $cfg = Config::get('database');
            $name = (string) $cfg['database'];
            if (!preg_match('/^[A-Za-z0-9_]+$/', $name)) {
                fail('DB_DATABASE solo puede contener letras, números y guion bajo.');
            }
            $pdo = Database::connect($cfg, false);
            $pdo->exec("CREATE DATABASE IF NOT EXISTS `{$name}` CHARACTER SET utf8mb4 COLLATE utf8mb4_0900_ai_ci");
            out("Base de datos `{$name}` lista.");
            break;

        case 'migrate':
            $migrator = new Migrator(Database::connection(), $base . '/database/migrations');
            $done = $migrator->migrate(static fn (string $m) => out("  ✔ {$m}"));
            out($done === [] ? 'No hay migraciones pendientes.' : count($done) . ' migración(es) aplicada(s).');
            break;

        case 'migrate:status':
            $migrator = new Migrator(Database::connection(), $base . '/database/migrations');
            foreach ($migrator->status() as $row) {
                out(str_pad($row['migracion'], 40) . $row['estado']);
            }
            break;

        case 'migrate:fresh':
            assertNonProduction('migrate:fresh');
            $migrator = new Migrator(Database::connection(), $base . '/database/migrations');
            $migrator->dropAllTables();
            out('Tablas eliminadas.');
            $migrator->migrate(static fn (string $m) => out("  ✔ {$m}"));
            if (in_array('--seed', $flags, true) || in_array('--demo', $flags, true)) {
                (new CatalogSeeder(Database::connection()))->run();
                out('Catálogo cargado.');
                if (in_array('--demo', $flags, true)) {
                    (new DemoSeeder(Database::connection()))->run();
                    out('Datos de demostración cargados.');
                }
            }
            break;

        case 'db:seed':
            (new CatalogSeeder(Database::connection()))->run();
            out('Catálogo cargado (roles, permisos, planes, plantillas, configuraciones).');
            if (in_array('--demo', $flags, true)) {
                assertNonProduction('db:seed --demo');
                $summary = (new DemoSeeder(Database::connection()))->run();
                out('Datos de demostración cargados:');
                foreach ($summary as $line) {
                    out('  - ' . $line);
                }
            }
            break;

        case 'schema:build':
            file_put_contents($base . '/database/schema.sql', Migrator::buildSchema($base . '/database/migrations'));
            out('database/schema.sql regenerado.');
            break;

        case 'routes':
            $router = new App\Core\Router();
            (require $base . '/routes/api.php')($router);
            foreach ($router->routes() as $r) {
                out(str_pad($r['method'], 8) . $r['path'] . ($r['name'] ? "  ({$r['name']})" : ''));
            }
            break;

        case 'docs:dictionary':
        case 'docs:generar':
        case 'docs:verificar':
            $gen = new \App\Services\Docs\DocsGenerator(dirname($base), Database::connection());
            if ($command === 'docs:verificar') {
                $stale = $gen->stale();
                foreach ($gen->problems() as $p) {
                    fwrite(STDERR, "PROBLEMA: {$p}" . PHP_EOL);
                }
                foreach ($stale as $f) {
                    fwrite(STDERR, "DESACTUALIZADO: {$f} (ejecuta php bin/console docs:generar)" . PHP_EOL);
                }
                if ($stale !== [] || $gen->problems() !== []) {
                    exit(1);
                }
                out('Documentación generada al día.');
                break;
            }
            $written = $gen->write();
            foreach ($gen->problems() as $p) {
                fwrite(STDERR, "PROBLEMA: {$p}" . PHP_EOL);
            }
            out($written === [] ? 'Nada que regenerar: la documentación ya estaba al día.' : 'Regenerados: ' . implode(', ', $written));
            if ($gen->problems() !== []) {
                exit(1);
            }
            break;

        case 'key:generate':
            $envFile = $base . '/.env';
            if (!is_file($envFile)) {
                fail('No existe backend/.env. Cópielo desde .env.example primero.');
            }
            $content = (string) file_get_contents($envFile);
            $hasKey = (bool) preg_match('/^APP_KEY=(.+)$/m', $content, $m) && trim($m[1]) !== '';
            if ($hasKey && !in_array('--force', $flags, true)) {
                out('APP_KEY ya existe. Use --force para reemplazarla (cerrará todas las sesiones móviles y web).');
                break;
            }
            $key = 'base64:' . base64_encode(random_bytes(32));
            $content = preg_match('/^APP_KEY=.*$/m', $content)
                ? (string) preg_replace('/^APP_KEY=.*$/m', 'APP_KEY=' . $key, $content)
                : rtrim($content) . PHP_EOL . 'APP_KEY=' . $key . PHP_EOL;
            file_put_contents($envFile, $content);
            out('APP_KEY generada en backend/.env.');
            break;

        case 'auth:purge':
            $s = (new App\Repositories\SessionRepository())->purge();
            $t = (new App\Repositories\UserTokenRepository())->purge();
            $l = (new App\Services\Auth\RateLimiter())->purge();
            out("Eliminados: {$s} sesiones, {$t} tokens de correo, {$l} contadores de intentos.");
            break;

        case 'reservas:purge':
            $k = App\Services\Booking\Idempotency::purge();
            out("Eliminadas: {$k} claves de idempotencia vencidas.");
            break;

        case 'notificaciones:procesar':
            $o = options($flags);
            $limite = isset($o['limite']) ? max(1, (int) $o['limite']) : null;
            // Un solo worker a la vez por servidor: si el cron anterior (o el servicio) sigue corriendo, este sale.
            $lock = fopen($base . '/storage/cache/notificaciones-worker.lock', 'c');
            if ($lock === false || !flock($lock, LOCK_EX | LOCK_NB)) {
                out('Otro worker de notificaciones sigue en ejecución; se omite esta corrida.');
                $heartbeat = false;
                break;
            }
            $fmt = static function (array $stats): string {
                $line = [];
                foreach ($stats as $k => $v) {
                    $line[] = "{$k}={$v}";
                }
                return gmdate('Y-m-d H:i:s') . ' UTC ' . implode(' ', $line);
            };
            if (!isset($o['continuo'])) {
                $stats = (new App\Services\Notifications\QueueWorker())->run($limite);
                flock($lock, LOCK_UN);
                out($fmt($stats));
                $heartbeatData = array_map('intval', array_filter($stats, 'is_numeric'));
                break;
            }
            // Modo permanente (Fase 15, servicio barberapp-worker): procesa, descansa unos segundos
            // si no hubo trabajo y sale solo tras --max-minutos o al recibir SIGTERM/SIGINT, al
            // terminar el lote en curso. systemd lo vuelve a iniciar (con el código desplegado).
            $pausa = max(1, (int) ($o['pausa'] ?? 5));
            $hasta = time() + 60 * max(1, (int) ($o['max-minutos'] ?? 60));
            $detener = false;
            if (function_exists('pcntl_async_signals')) {
                pcntl_async_signals(true);
                pcntl_signal(SIGTERM, static function () use (&$detener): void { $detener = true; });
                pcntl_signal(SIGINT, static function () use (&$detener): void { $detener = true; });
            }
            out(gmdate('Y-m-d H:i:s') . " UTC worker iniciado (pausa {$pausa} s).");
            while (!$detener && time() < $hasta) {
                try {
                    $stats = (new App\Services\Notifications\QueueWorker())->run($limite);
                    App\Services\Ops\Heartbeat::record('notificaciones:procesar', ['modo' => 'continuo'] + array_map('intval', array_filter($stats, 'is_numeric')));
                    $trabajo = array_sum(array_map('intval', array_filter($stats, 'is_numeric')));
                    if ($trabajo > 0) {
                        out($fmt($stats));
                    }
                } catch (Throwable $e) {
                    // Un fallo pasajero (base reiniciándose) no debe tumbar el servicio: se registra y se reintenta.
                    App\Core\Logger::error('Worker de notificaciones', ['exception' => $e]);
                    fwrite(STDERR, gmdate('Y-m-d H:i:s') . ' UTC error: ' . $e->getMessage() . PHP_EOL);
                    Database::setConnection(null);
                    $trabajo = 0;
                    $pausa = min(60, $pausa * 2);
                }
                for ($i = 0; $i < ($trabajo > 0 ? 0 : $pausa) && !$detener; $i++) {
                    sleep(1);
                }
            }
            flock($lock, LOCK_UN);
            out(gmdate('Y-m-d H:i:s') . ' UTC worker detenido' . ($detener ? ' (señal)' : ' (tiempo máximo)') . '.');
            $heartbeat = false;
            break;

        case 'notificaciones:estado':
            $pdo = Database::connection();
            out('Cola (todas las barberías):');
            foreach ($pdo->query("SELECT estado, canal, COUNT(*) AS n FROM notificaciones WHERE canal <> 'interna' OR tipo = 'recordatorio' GROUP BY estado, canal ORDER BY estado, canal")->fetchAll() as $r) {
                out(sprintf('  %-11s %-8s %d', $r['estado'], $r['canal'], $r['n']));
            }
            $vencidas = (int) $pdo->query("SELECT COUNT(*) FROM notificaciones WHERE estado = 'programada' AND programada_para_utc < UTC_TIMESTAMP() - INTERVAL 5 MINUTE")->fetchColumn();
            out("Avisos atrasados más de 5 min: {$vencidas}" . ($vencidas > 0 ? '  ← ¿está corriendo el cron del worker?' : ''));
            out('Intentos de envío en las últimas 24 h:');
            foreach ($pdo->query("SELECT canal, proveedor, resultado, COUNT(*) AS n FROM notificacion_envios WHERE created_at >= UTC_TIMESTAMP() - INTERVAL 1 DAY GROUP BY canal, proveedor, resultado ORDER BY canal, resultado")->fetchAll() as $r) {
                out(sprintf('  %-8s %-6s %-16s %d', $r['canal'], $r['proveedor'], $r['resultado'], $r['n']));
            }
            break;

        case 'notificaciones:purge':
            $dias = max(30, (int) Config::get('notifications.retention_days', 180));
            $pdo = Database::connection();
            $stmt = $pdo->prepare("DELETE FROM notificaciones WHERE estado IN ('enviada','fallida','cancelada','omitida') AND programada_para_utc < UTC_TIMESTAMP() - INTERVAL ? DAY LIMIT 5000");
            $total = 0;
            do {
                $stmt->execute([$dias]);
                $total += $stmt->rowCount();
            } while ($stmt->rowCount() === 5000);
            $d = $pdo->prepare('DELETE FROM dispositivos_push WHERE activo = 0 AND desactivado_en < UTC_TIMESTAMP() - INTERVAL ? DAY');
            $d->execute([$dias]);
            out("Eliminados: {$total} avisos de más de {$dias} días (con su registro de envíos) y {$d->rowCount()} dispositivos desactivados.");
            break;

        case 'suscripciones:vencer':
            // Fase 10: cambios programados, vencimientos, restricción tras la gracia, avisos y órdenes expiradas.
            $lock = fopen($base . '/storage/cache/suscripciones.lock', 'c');
            if ($lock === false || !flock($lock, LOCK_EX | LOCK_NB)) {
                out('Otra ejecución de suscripciones:vencer está en curso.');
                $heartbeat = false;
                break;
            }
            $r = (new App\Services\Billing\Lifecycle())->run();
            out(gmdate('Y-m-d H:i:s') . ' UTC ' . implode(' · ', array_map(static fn ($k, $v) => str_replace('_', ' ', $k) . ": {$v}", array_keys($r), $r)));
            flock($lock, LOCK_UN);
            break;

        case 'push:probar':
            $email = (string) ($flags[0] ?? '');
            $u = (new App\Repositories\UserRepository())->findByEmail($email);
            if ($u === null) {
                fail('Uso: php bin/console push:probar correo@dominio (la cuenta debe existir).');
            }
            $transport = App\Services\Notifications\Push\Push::transport();
            if ($transport === null) {
                fail('PUSH_DRIVER=none: el envío push está desactivado.');
            }
            $stmt = Database::connection()->prepare('SELECT token, plataforma, modelo FROM dispositivos_push WHERE usuario_id = ? AND activo = 1');
            $stmt->execute([(int) $u['id']]);
            $devices = $stmt->fetchAll();
            if ($devices === []) {
                fail('Esa cuenta no tiene dispositivos con avisos activados (la app los registra en POST /api/v1/me/dispositivos).');
            }
            foreach ($devices as $dev) {
                $res = $transport->send((string) $dev['token'], (string) $dev['plataforma'], [
                    'title' => 'Prueba de BARBERAPP', 'body' => 'Si ves este aviso, el envío push funciona.', 'data' => ['tipo' => 'prueba'],
                ]);
                out(sprintf('  %s %s → %s%s', $dev['plataforma'], $dev['modelo'] ?? '', $res->status, $res->code ? " ({$res->code})" : '') . ($res->detail ? ': ' . $res->detail : ''));
            }
            break;

        case 'seguridad:revisar':
            $errores = 0;
            foreach (App\Services\Security\SecurityCheck::run($base) as $item) {
                $marca = ['ok' => '  ✔', 'aviso' => '  !', 'error' => '  ✖'][$item['nivel']];
                $errores += $item['nivel'] === 'error' ? 1 : 0;
                out("{$marca} {$item['tema']}: {$item['mensaje']}");
            }
            out($errores === 0 ? 'Sin errores críticos.' : "{$errores} error(es) crítico(s): corrígelos antes de publicar.");
            if ($errores > 0) {
                exit(1);
            }
            break;

        case 'privacidad:retencion':
            $r = (new App\Services\Privacy\Retention())->run();
            out("Retención aplicada: {$r['auditoria']} registros de auditoría, {$r['webhooks']} webhooks, {$r['solicitudes']} solicitudes cerradas "
                . "y {$r['cuentas_sin_verificar']} cuentas sin verificar eliminadas.");
            break;

        case 'backup:clave':
            $envFile = $base . '/.env';
            if (!is_file($envFile)) {
                fail('No existe backend/.env. Cópielo desde .env.example primero.');
            }
            $content = (string) file_get_contents($envFile);
            if (preg_match('/^BACKUP_KEY=(.+)$/m', $content, $m) && trim($m[1]) !== '' && !in_array('--force', $flags, true)) {
                out('BACKUP_KEY ya existe. Use --force para reemplazarla (las copias anteriores solo se restauran con la clave anterior).');
                break;
            }
            $key = App\Services\Backup\BackupCipher::generateKey();
            $content = preg_match('/^BACKUP_KEY=.*$/m', $content)
                ? (string) preg_replace('/^BACKUP_KEY=.*$/m', 'BACKUP_KEY=' . $key, $content)
                : rtrim($content) . PHP_EOL . 'BACKUP_KEY=' . $key . PHP_EOL;
            file_put_contents($envFile, $content);
            out('BACKUP_KEY generada en backend/.env. Guarda una copia de esta clave FUERA del servidor (gestor de contraseñas):');
            out('  ' . $key);
            out('Sin ella no se pueden restaurar las copias.');
            break;

        case 'backup:crear':
            $r = (new App\Services\Backup\BackupService())->create();
            out(sprintf('Copia creada: %s (%s, %.1f MB, %d tablas, %d filas).', $r['archivo'], $r['cifrado'] ? 'cifrada' : 'SIN CIFRAR', $r['bytes'] / 1048576, $r['tablas'], $r['filas']));
            out('SHA-256: ' . $r['sha256']);
            foreach ($r['borradas'] as $old) {
                out("  borrada copia antigua {$old}");
            }
            if (!$r['cifrado']) {
                out('Aviso: sin BACKUP_KEY la copia no está cifrada (solo se permite en local).');
            }
            break;

        case 'backup:listar':
            $svc = new App\Services\Backup\BackupService();
            $files = $svc->list();
            out($files === [] ? 'No hay copias en ' . $svc->directory() . '.' : 'Copias en ' . $svc->directory() . ':');
            foreach ($files as $f) {
                out(sprintf('  %s  %.1f MB  %s', basename($f), filesize($f) / 1048576, gmdate('Y-m-d H:i', (int) filemtime($f)) . ' UTC'));
            }
            break;

        case 'backup:verificar':
            $r = (new App\Services\Backup\BackupService())->verify($flags[0] ?? null);
            out(sprintf('Restauración de prueba de %s en `%s`: %d tablas, %d filas, %.2f s.', basename($r['archivo']), $r['base'], $r['tablas'], $r['filas'], $r['segundos']));
            foreach ($r['diferencias'] as $t => $d) {
                out("  ✖ {$t}: esperado {$d['esperado']}, restaurado {$d['restaurado']}");
            }
            out($r['ok'] ? 'Copia verificada: se puede restaurar.' : 'La copia NO coincide con su manifiesto.');
            App\Services\Audit::record('sistema.backup_verificado', $r['ok'] ? 'exito' : 'error', null, null, null, null, null, ['archivo' => basename($r['archivo']), 'filas' => $r['filas']]);
            if (!$r['ok']) {
                exit(1);
            }
            break;

        case 'backup:restaurar':
            $file = $flags[0] ?? '';
            $opts = [];
            foreach (array_slice($flags, 1) as $f) {
                if (preg_match('/^--([a-z-]+)(?:=(.*))?$/', $f, $m)) {
                    $opts[$m[1]] = $m[2] ?? true;
                }
            }
            if ($file === '' || str_starts_with($file, '--')) {
                fail('Uso: php bin/console backup:restaurar <archivo> --base=<nombre> [--sobrescribir]');
            }
            $svc = new App\Services\Backup\BackupService();
            if (isset($opts['solo-descifrar'])) {
                $dest = (string) $opts['solo-descifrar'];
                if ($dest === '' || $dest === '1' || file_exists($dest)) {
                    fail('Indica un archivo de destino que no exista: --solo-descifrar=/ruta/copia.sql.gz');
                }
                $plain = $svc->plainCopy($file);
                $plain['temp'] ? rename($plain['path'], $dest) : copy($plain['path'], $dest);
                @chmod($dest, 0600);
                out("Copia descifrada en {$dest}. Restaurar: gunzip -c {$dest} | mysql -u USUARIO -p BASE. Borra el archivo al terminar.");
                break;
            }
            $target = (string) ($opts['base'] ?? '');
            $main = (string) Config::get('database.database');
            if ($target === '' || $target === '1') {
                fail('Indica la base de destino con --base=<nombre>.');
            }
            if ($target === $main && !isset($opts['sobrescribir'])) {
                fail("Restaurar sobre la base principal ({$main}) BORRA sus datos actuales. Si es lo que quieres, agrega --sobrescribir (y detén la API y los cron antes).");
            }
            $r = $svc->restore($file, $target, isset($opts['limpiar']));
            out(sprintf('Restaurada en `%s`: %d tablas, %d filas.', $target, count($r['manifiesto']), array_sum($r['manifiesto'])));
            App\Services\Audit::record('sistema.backup_restaurado', 'exito', null, null, null, null, null, ['archivo' => basename($file), 'base' => $target]);
            break;

        // ============================================================ Fase 15: producción

        case 'backup:enviar':
            $off = new App\Services\Backup\OffsiteBackup();
            $r = $off->push();
            out(gmdate('Y-m-d H:i:s') . ' UTC copias fuera del servidor: ' . count($r['subidas']) . " subida(s), {$r['ya_estaban']} ya estaban, " . count($r['borradas']) . ' borrada(s) por antigüedad.');
            foreach ($r['subidas'] as $n) {
                out("  ↑ {$n}");
            }
            foreach ($r['omitidas_sin_cifrar'] as $n) {
                out("  ! {$n} no está cifrada y no se sube (configura BACKUP_KEY).");
            }
            $m = $r['media'];
            out(sprintf('Fotos: %d subida(s) (%.1f MB), %d sin cambios, %d borrada(s)%s.', $m['subidas'], $m['bytes'] / 1048576, $m['ya_estaban'], $m['borradas'],
                $m['no_borradas'] > 0 ? ", {$m['no_borradas']} sin permiso para borrar" : ''));
            $heartbeatData = ['subidas' => count($r['subidas']), 'fotos' => $m['subidas']];
            break;

        case 'backup:remotas':
            $list = (new App\Services\Backup\OffsiteBackup())->remote();
            out($list === [] ? 'No hay copias fuera del servidor.' : count($list) . ' copia(s) fuera del servidor:');
            foreach ($list as $c) {
                out(sprintf('  %s  %.1f MB  %s', $c['nombre'], $c['bytes'] / 1048576, $c['fecha']));
            }
            break;

        case 'backup:traer':
            $name = isset($flags[0]) && !str_starts_with($flags[0], '--') ? $flags[0] : null;
            $path = (new App\Services\Backup\OffsiteBackup())->pull($name);
            out("Copia descargada y verificada (SHA-256): {$path}");
            out('Siguiente paso: php bin/console backup:verificar ' . basename($path) . '  o  backup:restaurar ' . basename($path) . ' --base=<nombre>');
            break;

        case 'monitor:revisar':
            $o = options($flags);
            $checks = App\Services\Ops\Monitor::run($base, !isset($o['sin-certificados']));
            $errors = count(array_filter($checks, static fn (array $c): bool => $c['nivel'] === 'error'));
            if (isset($o['json'])) {
                out((string) json_encode(['estado' => $errors === 0 ? 'ok' : 'error', 'revisado_en' => gmdate('Y-m-d\TH:i:s\Z'), 'puntos' => $checks], JSON_PRETTY_PRINT | JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES));
            } elseif (!isset($o['silencioso']) || $errors > 0) {
                out(gmdate('Y-m-d H:i:s') . ' UTC monitor:');
                printChecks($checks, isset($o['silencioso']));
                out($errors === 0 ? 'Todo en orden.' : "{$errors} problema(s).");
            }
            if (isset($o['alertar'])) {
                $sent = App\Services\Ops\Monitor::alert($checks);
                if ($sent !== null) {
                    out("Alerta enviada: {$sent}");
                } elseif ($errors > 0 && (string) Config::get('ops.alert_email', '') === '') {
                    out('Aviso: MONITOR_EMAIL vacío; no se envió ninguna alerta.');
                }
            }
            if ($errors > 0) {
                exit(1);
            }
            break;

        case 'mantenimiento:activar':
            $o = options($flags);
            App\Services\Ops\Maintenance::enable((string) ($o['motivo'] ?? 'actualizacion'), (int) ($o['reintentar'] ?? 60));
            out('API en mantenimiento: responde 503 hasta ejecutar mantenimiento:desactivar.');
            break;

        case 'mantenimiento:desactivar':
            App\Services\Ops\Maintenance::disable();
            out('Mantenimiento desactivado: la API vuelve a atender.');
            break;

        case 'mantenimiento:estado':
            $st = App\Services\Ops\Maintenance::status();
            out($st === null ? 'La API está atendiendo (sin mantenimiento).' : "En mantenimiento desde {$st['desde']} ({$st['motivo']}).");
            break;

        case 'logs:purge':
            $r = App\Services\Ops\LogPurge::run();
            out("Eliminados {$r['borrados']} registro(s) de la aplicación de más de {$r['dias']} días.");
            $heartbeatData = ['borrados' => $r['borrados']];
            break;

        case 'plataforma:superadmin':
            $email = isset($flags[0]) && !str_starts_with($flags[0], '--') ? $flags[0] : '';
            if ($email === '') {
                fail('Uso: php bin/console plataforma:superadmin correo@dominio [--nombre="Nombre"] [--apellidos="Apellidos"]');
            }
            $o = options(array_slice($flags, 1));
            $r = App\Services\Platform\PlatformAdmin::ensure($email, (string) ($o['nombre'] ?? 'Administrador'), isset($o['apellidos']) ? (string) $o['apellidos'] : null);
            if ($r['creado']) {
                out("Cuenta de superadministrador creada para {$email}.");
                out("Contraseña temporal (se muestra una sola vez): {$r['clave']}");
                out('Entra en el panel de la plataforma y cámbiala en Mi cuenta → Contraseña.');
            } else {
                out("{$email} ahora es superadministrador de la plataforma.");
            }
            break;

        case 'despliegue:verificar':
            $o = options($flags);
            out('Revisión previa al despliegue (' . (string) Config::get('app.env') . '):');
            $errors = printChecks(App\Services\Ops\Preflight::run($base, !isset($o['sin-dns'])));
            out($errors === 0 ? 'Lista para publicar.' : "{$errors} error(es): la versión no se publica.");
            if ($errors > 0) {
                exit(1);
            }
            break;

        case 'despliegue:config':
            $o = options($flags);
            $dest = (string) ($o['salida'] ?? '');
            if ($dest === '' || $dest === '1') {
                fail('Indica la carpeta de destino: --salida=/ruta (ver docs/DESPLIEGUE.md).');
            }
            unset($o['salida']);
            $files = App\Services\Ops\DeployConfig::generate(dirname($base) . '/infrastructure', $dest, $o);
            out('Configuración generada en ' . $dest . ':');
            foreach ($files as $f) {
                out("  {$f}");
            }
            break;

        case 'despliegue:frontend':
            $o = options($flags);
            $www = (string) ($o['www'] ?? dirname($base) . '/frontend/www');
            $release = (string) ($o['version'] ?? gmdate('YmdHis'));
            $api = rtrim((string) Config::get('app.url'), '/') . '/api/v1';
            $r = App\Services\Ops\FrontendBuild::apply($www, $api, $release);
            out("Frontend listo: API {$r['api']} · service worker {$r['version']}.");
            break;

        default:
            out(trim((string) preg_replace('/^.*?\/\*\*|\*\/.*$/s', '', (string) file_get_contents(__FILE__))));
            $heartbeat = false;
    }
    if ($heartbeat) {
        App\Services\Ops\Heartbeat::record($command, $heartbeatData);
    }
} catch (Throwable $e) {
    fail($e->getMessage());
}
