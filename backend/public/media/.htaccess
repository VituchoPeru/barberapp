# Imágenes subidas por las barberías: solo se sirven como archivos estáticos.
# Nunca se ejecuta código aquí, aunque alguien lograra colocar un archivo.
Options -Indexes -ExecCGI
<IfModule mod_php.c>
    php_flag engine off
</IfModule>
<IfModule mod_php7.c>
    php_flag engine off
</IfModule>
<IfModule mod_php8.c>
    php_flag engine off
</IfModule>
RemoveHandler .php .phtml .phar .cgi .pl .py
RemoveType .php .phtml .phar
<FilesMatch "\.(?i:php\d?|phtml|phar|cgi|pl|py|sh|html?|svg|js)$">
    Require all denied
</FilesMatch>
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Content-Security-Policy "default-src 'none'; img-src 'self'; style-src 'none'; sandbox"
    Header set Cache-Control "public, max-age=2592000, immutable"
</IfModule>
