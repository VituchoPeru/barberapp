# ============================================================
# BARBERAPP — variables de entorno de PRODUCCIÓN (Fase 15)
# instalar-vps.sh copia este archivo a /var/www/barberapp/shared/.env y completa las claves.
# Permisos: chmod 640, dueño root:barberapp. NUNCA lo subas al repositorio ni a una carpeta pública.
# Valores marcados con «⇢» son tuyos: dominio, correo, credenciales.
# ============================================================

APP_NAME=BARBERAPP
APP_ENV=production
APP_DEBUG=false
# ⇢ Dominios (referenciales: verifica que sean tuyos y que el DNS apunte al servidor).
APP_URL=https://api.barberapp.pe
FRONTEND_URL=https://app.barberapp.pe
ADMIN_URL=https://admin.barberapp.pe
PLATFORM_URL=https://platform.barberapp.pe
PUBLIC_BOOKING_URL=https://app.barberapp.pe
FORCE_HTTPS=true
LOG_LEVEL=info
# Registros fuera de la versión desplegada (se conservan entre actualizaciones).
LOG_PATH=/var/log/barberapp
LOG_RETENTION_DAYS=30
DEFAULT_TENANT_TIMEZONE=America/Lima
MAX_BODY_BYTES=1048576

# Lo genera instalar-vps.sh (php bin/console key:generate). Cambiarla cierra todas las sesiones.
APP_KEY=

SESSION_COOKIE_NAME=barberapp_session
SESSION_SECURE_COOKIE=true
SESSION_SAMESITE=Lax
SESSION_LIFETIME_HOURS=168
SESSION_IDLE_MINUTES=120
AUTH_ACCESS_TTL=900
AUTH_REFRESH_TTL_DAYS=30
AUTH_MOBILE_SESSION_DAYS=90

# ⇢ Correo saliente (SMTP de tu proveedor: Amazon SES, Brevo, Mailgun, Google Workspace…).
MAIL_DRIVER=smtp
MAIL_FROM_ADDRESS=no-reply@barberapp.pe
MAIL_FROM_NAME=BARBERAPP
MAIL_HOST=
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=
MAIL_PASSWORD=

# MySQL 8: usuario propio (nunca root). instalar-vps.sh crea la base y una contraseña aleatoria.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=barberapp
DB_USERNAME=barberapp
DB_PASSWORD=
DB_SOCKET=
DB_TIMEOUT=5

# Frontends web (los tres dominios) y la app nativa (Android https://localhost, iOS capacitor://localhost).
CORS_ALLOWED_ORIGINS=https://app.barberapp.pe,https://admin.barberapp.pe,https://platform.barberapp.pe,capacitor://localhost,https://localhost

# Fotos de las barberías: carpeta compartida entre versiones, servida por Nginx/Apache en APP_URL/media.
MEDIA_PATH=/var/www/barberapp/shared/media
MEDIA_URL=https://api.barberapp.pe/media
MEDIA_MAX_UPLOAD_BYTES=5242880

# ⇢ Avisos push: cuenta de servicio de Firebase fuera del repositorio y de la web.
PUSH_DRIVER=fcm
FCM_CREDENTIALS=/etc/barberapp/firebase-adminsdk.json
FCM_PROJECT_ID=
NOTIFY_MAX_ATTEMPTS=5
NOTIFY_RETENTION_DAYS=180

# ⇢ Cobro de suscripciones. "none" hasta tener las credenciales de Mercado Pago y resolver SUNAT/IGV.
PAYMENT_DRIVER=none
PAYMENT_ORDER_TTL_MINUTES=1440
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
MP_STATEMENT_DESCRIPTOR=BARBERAPP
MP_SIGNATURE_TOLERANCE=600

# ⇢ Si hay Cloudflare o un balanceador delante: sus rangos de IP (CIDR, separados por coma).
TRUSTED_PROXIES=
RATE_LIMIT_WRITES=120
LEGAL_TERMINOS_VERSION=2026-10-22
LEGAL_PRIVACIDAD_VERSION=2026-10-22
RETENTION_AUDIT_DAYS=365
RETENTION_WEBHOOK_DAYS=180
RETENTION_UNVERIFIED_DAYS=90
RETENTION_REQUESTS_DAYS=1825

# Copias cifradas en el servidor (fuera de la web; solo el usuario barberapp las lee).
BACKUP_PATH=/var/backups/barberapp
# Lo genera instalar-vps.sh (php bin/console backup:clave). ⇢ GUÁRDALA en tu gestor de contraseñas:
# sin ella ninguna copia (ni la del servidor ni la externa) se puede restaurar.
BACKUP_KEY=
BACKUP_KEEP=14
BACKUP_VERIFY_DATABASE=

# ⇢ Copias FUERA del servidor (bucket compatible con S3). Ejemplos de BACKUP_S3_ENDPOINT:
#   Amazon S3 (São Paulo):  https://s3.sa-east-1.amazonaws.com   (BACKUP_S3_REGION=sa-east-1)
#   Cloudflare R2:          https://<cuenta>.r2.cloudflarestorage.com   (BACKUP_S3_REGION=auto)
#   Backblaze B2:           https://s3.us-west-004.backblazeb2.com  (BACKUP_S3_REGION=us-west-004)
#   DigitalOcean Spaces:    https://nyc3.digitaloceanspaces.com     (BACKUP_S3_REGION=nyc3)
# Usa una clave con permiso solo de escribir y leer en ese bucket, y una regla de ciclo de vida
# que borre las copias de más de 30 días (ver docs/DESPLIEGUE.md, "Copias fuera del servidor").
BACKUP_S3_ENDPOINT=
BACKUP_S3_REGION=
BACKUP_S3_BUCKET=
BACKUP_S3_KEY=
BACKUP_S3_SECRET=
BACKUP_S3_PREFIX=barberapp/produccion
BACKUP_S3_PATH_STYLE=false
# 0 = el servidor nunca borra copias del bucket (lo hace la regla de ciclo de vida). Recomendado.
BACKUP_REMOTE_KEEP=0
BACKUP_S3_MEDIA=true

# ⇢ Monitoreo (monitor:revisar --alertar cada 5 min): a quién avisar y token para monitores externos
# (GET https://api.barberapp.pe/api/v1/health/operacion con "Authorization: Bearer <token>").
MONITOR_EMAIL=
MONITOR_TOKEN=
MONITOR_MAX_WORKER_MIN=5
MONITOR_MIN_DISCO_LIBRE=10
MONITOR_MAX_ERRORES_HORA=20
MONITOR_MIN_DIAS_CERTIFICADO=14
MONITOR_REPETIR_HORAS=6

DB_TEST_DATABASE=barberapp_test
DEMO_PASSWORD=
